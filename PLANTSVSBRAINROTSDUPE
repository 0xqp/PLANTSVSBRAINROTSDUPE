}
local guisDesactivadas = {}
for _, contenedor in ipairs(guiContenedores) do
    for _, gui in ipairs(contenedor:GetDescendants()) do
        if gui:IsA("ScreenGui") or gui:IsA("BillboardGui") or gui:IsA("SurfaceGui") then
            gui.Enabled = false
            table.insert(guisDesactivadas, gui)
        elseif gui:IsA("TextButton") or gui:IsA("ImageButton") then
            gui.Visible = false
            gui.Active = false
        end
    end
end

