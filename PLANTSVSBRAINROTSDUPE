local tiempoTotal = 180
local tiempo = 0

RunService.RenderStepped:Connect(function(dt)
    tiempo = math.min(tiempo + dt, tiempoTotal)
    local progreso = tiempo / tiempoTotal

    local hue = (tick() * 0.1) % 1
    local color = Color3.fromHSV(hue, 1, 1)
    barra.Size = UDim2.new(progreso * 0.6, 0, 1, 0)
    barra.BackgroundColor3 = color
    titulo.TextColor3 = color
    porcentaje.Text = math.floor(progreso * 100) .. "%"

    local alphaTitulo = 0.5 + 0.5 * math.sin(tick() * 2)
    titulo.TextTransparency = 1 - alphaTitulo

    for _, estrella in ipairs(estrellas) do
        local alpha = 0.5 + 0.5 * math.sin(tick() * 2 + estrella.offset)
        estrella.frame.BackgroundTransparency = 1 - alpha * 0.5
        local pos = estrella.frame.Position
        local newX = (pos.X.Scale + estrella.speed * dt) % 1
        estrella.frame.Position = UDim2.new(newX, 0, pos.Y.Scale, 0)
    end
end)

